<div class="modal" id="vmodal" aria-hidden="true">
  <div class="mbd" data-close></div>
  <div class="mbox" role="dialog" aria-modal="true" aria-labelledby="mtitle">
    <div class="mhead">
      <span class="mnum" id="mnum">1</span>
      <span class="mtitle" id="mtitle">Episode</span>
      <button class="mclose" id="mclose" type="button" aria-label="Close">&times;</button>
    </div>
    <div class="mvid">
      <iframe id="mframe" title="YouTube video player" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      <div class="mthumb" id="mthumb" role="button" tabindex="0" aria-label="Play video in a popup window">
        <img id="mthumbimg" alt="">
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path fill="#fff" d="M8 5v14l11-7z"/></svg></span>
        <span class="mnote" id="mnote"></span>
      </div>
    </div>
    <div class="murl">
      <input id="murlin" readonly aria-label="Video URL">
      <button class="mbtn" id="mcopyurl" type="button">Copy link</button>
      <a class="mbtn pri" id="mopen" target="_blank" rel="noopener">Open on YouTube</a>
    </div>
  </div>
</div>

