<script>
(function(){
  var cards = Array.prototype.slice.call(document.querySelectorAll('.card'));
  var search = document.getElementById('q');
  var nores = document.getElementById('nores');
  var progEl = document.getElementById('prog');

  function setOpen(card, on){ card.classList.toggle('open', on);
    card.querySelector('.ctoggle').setAttribute('aria-expanded', on ? 'true':'false'); }

  cards.forEach(function(card){
    card.querySelector('.ctoggle').addEventListener('click', function(){
      setOpen(card, !card.classList.contains('open'));
    });
  });

  document.getElementById('expand').addEventListener('click', function(){
    cards.forEach(function(c){ if(!c.classList.contains('hidden')) setOpen(c,true); });
  });
  document.getElementById('collapse').addEventListener('click', function(){
    cards.forEach(function(c){ setOpen(c,false); });
  });

  // progress (in-memory for this page view)
  function updateProg(){
    var done = document.querySelectorAll('.dchk:checked').length;
    progEl.innerHTML = '<b>'+done+'</b> / '+cards.length+' done';
  }
  document.querySelectorAll('.dchk').forEach(function(c){
    c.addEventListener('change', updateProg);
  });
  updateProg();

  // search
  var t;
  search.addEventListener('input', function(){
    clearTimeout(t);
    t = setTimeout(function(){
      var q = search.value.trim().toLowerCase();
      var shown = 0;
      cards.forEach(function(card){
        if(!q){ card.classList.remove('hidden'); shown++; return; }
        var hit = card.getAttribute('data-search').indexOf(q) !== -1;
        card.classList.toggle('hidden', !hit);
        if(hit){ shown++; setOpen(card, true); }
      });
      nores.classList.toggle('on', shown === 0);
    }, 110);
  });

  document.addEventListener('keydown', function(e){
    if(e.key === '/' && document.activeElement !== search){ e.preventDefault(); search.focus(); }
    if(e.key === 'Escape' && document.activeElement === search){ search.value=''; search.dispatchEvent(new Event('input')); search.blur(); }
  });

  // copy buttons
  document.querySelectorAll('.copy').forEach(function(btn){
    btn.addEventListener('click', function(){
      var code = btn.parentNode.querySelector('code').innerText;
      var done = function(){ btn.textContent='Copied'; btn.classList.add('ok');
        setTimeout(function(){ btn.textContent='Copy'; btn.classList.remove('ok'); }, 1400); };
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(code).then(done, function(){});
      } else {
        var ta=document.createElement('textarea'); ta.value=code; document.body.appendChild(ta);
        ta.select(); try{document.execCommand('copy');}catch(err){} document.body.removeChild(ta); done();
      }
    });
  });

  // ---- video modal ----
  var LIST = 'PLhieaQmOk7nIfMZ1UmvKGPrwuwQVwAvFa';
  var modal = document.getElementById('vmodal');
  var frame = document.getElementById('mframe');
  var thumb = document.getElementById('mthumb');
  var thumbImg = document.getElementById('mthumbimg');
  var note  = document.getElementById('mnote');
  var urlIn = document.getElementById('murlin');
  var openA = document.getElementById('mopen');
  var lastFocus = null, curWatch = '';

  // YouTube refuses to embed into pages served from file:// (it has no origin to
  // verify and answers with "Error 153"). Detect that up front and show a poster
  // + popup player instead of a broken iframe.
  var CAN_EMBED = (location.protocol === 'http:' || location.protocol === 'https:');

  function showPoster(vid, msg){
    frame.src = '';
    frame.style.display = 'none';
    thumbImg.onerror = function(){
      thumbImg.onerror = null;
      thumbImg.src = 'https://i.ytimg.com/vi/' + vid + '/hqdefault.jpg';
    };
    thumbImg.src = 'https://i.ytimg.com/vi/' + vid + '/maxresdefault.jpg';
    note.innerHTML = msg;
    thumb.classList.add('on');
  }

  function popPlayer(){
    if(!curWatch) return;
    var w = Math.min(1000, screen.availWidth - 80);
    var h = Math.round(w * 0.62) + 100;
    var x = Math.max(0, Math.round((screen.availWidth  - w) / 2));
    var y = Math.max(0, Math.round((screen.availHeight - h) / 2));
    var win = window.open(curWatch, 'ytPlayerPopup',
      'width=' + w + ',height=' + h + ',left=' + x + ',top=' + y +
      ',menubar=no,toolbar=no,location=no,status=no,resizable=yes,scrollbars=yes');
    if(win){ win.focus(); } else { window.open(curWatch, '_blank', 'noopener'); }
  }
  thumb.addEventListener('click', popPlayer);
  thumb.addEventListener('keydown', function(e){
    if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); popPlayer(); }
  });

  function openVideo(vid, num, title){
    lastFocus = document.activeElement;
    curWatch = 'https://www.youtube.com/watch?v=' + vid + '&list=' + LIST;
    document.getElementById('mnum').textContent = num;
    document.getElementById('mtitle').textContent = title;
    urlIn.value = curWatch;
    openA.href = curWatch;

    thumb.classList.remove('on');
    delete frame.dataset.loaded;
    clearTimeout(openVideo._t);

    if(CAN_EMBED){
      frame.style.display = 'block';
      frame.src = 'https://www.youtube-nocookie.com/embed/' + vid +
                  '?list=' + LIST + '&rel=0&autoplay=1&modestbranding=1';
      // if the embed is refused anyway (blocked video, no network), fall back
      openVideo._t = setTimeout(function(){
        if(modal.classList.contains('on') && !frame.dataset.loaded){
          showPoster(vid, 'This video would not load in the box. ' +
            '<b>Click to play it in a popup window.</b>');
        }
      }, 4500);
    } else {
      showPoster(vid, 'You are viewing this page as a local file, and YouTube ' +
        'blocks embedded playback there. <b>Click to play in a popup window.</b>');
    }

    modal.classList.add('on');
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('locked');
    document.getElementById('mclose').focus();
  }
  frame.addEventListener('load', function(){ frame.dataset.loaded = '1'; });

  function closeVideo(){
    modal.classList.remove('on');
    modal.setAttribute('aria-hidden','true');
    document.body.classList.remove('locked');
    clearTimeout(openVideo._t);
    frame.src = '';                 // stops playback
    delete frame.dataset.loaded;
    if(lastFocus) lastFocus.focus();
  }

  document.querySelectorAll('.yt').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      openVideo(btn.dataset.vid, btn.dataset.n, btn.dataset.title);
    });
  });
  document.getElementById('mclose').addEventListener('click', closeVideo);
  modal.querySelector('.mbd').addEventListener('click', closeVideo);
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && modal.classList.contains('on')) closeVideo();
  });
  document.getElementById('mcopyurl').addEventListener('click', function(){
    var b = this;
    var mark = function(){ b.textContent='Copied'; b.classList.add('ok');
      setTimeout(function(){ b.textContent='Copy link'; b.classList.remove('ok'); },1400); };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(urlIn.value).then(mark, function(){});
    } else { urlIn.select(); try{document.execCommand('copy');}catch(err){} mark(); }
  });

  // open card when linked from TOC
  document.querySelectorAll('.tocitem').forEach(function(a){
    a.addEventListener('click', function(){
      var el = document.querySelector(a.getAttribute('href'));
      if(el) setOpen(el, true);
    });
  });

  // active TOC highlight
  var links = {};
  document.querySelectorAll('.tocitem').forEach(function(a){ links[a.getAttribute('href').slice(1)] = a; });
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      var a = links[en.target.id];
      if(a && en.isIntersecting){
        document.querySelectorAll('.tocitem.on').forEach(function(x){x.classList.remove('on');});
        a.classList.add('on');
      }
    });
  }, {rootMargin:'-80px 0px -70% 0px'});
  cards.forEach(function(c){ io.observe(c); });

  // open first card by default
  if(cards[0]) setOpen(cards[0], true);
  if(location.hash){ var h=document.querySelector(location.hash); if(h) setOpen(h,true); }
})();
</script>
